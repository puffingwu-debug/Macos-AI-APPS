/* pages/mine 样式 */

.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.card {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: var(--qt-radius, 16rpx);
  background-color: var(--qt-card, #ffffff);
  box-shadow: var(--qt-shadow, 0 2rpx 12rpx rgba(0, 0, 0, 0.04));
}

.card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--qt-text-2, #7a7a7a);
  margin-bottom: 12rpx;
}

/* 键值行 */
.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1px solid var(--qt-border, #ededed);
}

.kv.last {
  border-bottom: none;
}

.k {
  font-size: 28rpx;
  color: var(--qt-text-2, #7a7a7a);
  flex: none;
}

.v {
  font-size: 27rpx;
  color: var(--qt-text, #181818);
  margin-left: 20rpx;
  text-align: right;
  word-break: break-all;
}

.v.ok {
  color: var(--qt-primary, #07c160);
}

.v.warn {
  color: #ff9f0a;
}

/* 按钮 */
.btn-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.btn {
  flex: 1;
  margin-right: 20rpx;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background-color: var(--qt-primary, #07c160);
  color: #ffffff;
  font-size: 28rpx;
  text-align: center;
}

.btn:last-child {
  margin-right: 0;
}

.btn.ghost {
  background-color: var(--qt-card, #ffffff);
  color: var(--qt-text, #181818);
  border: 1px solid var(--qt-border, #ededed);
  box-sizing: border-box;
}

.btn:active {
  opacity: 0.85;
}

.hint {
  margin-top: 18rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--qt-text-3, #b2b2b2);
}

/* 统计 */
.stat-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--qt-text, #181818);
  line-height: 1.2;
}

.stat-num.primary {
  color: var(--qt-primary, #07c160);
}

.stat-num.warn {
  color: #ff9f0a;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--qt-text-3, #b2b2b2);
}

/* 列表项 */
.cell {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1px solid var(--qt-border, #ededed);
}

.cell.last {
  border-bottom: none;
}

.cell-main {
  flex: 1;
  min-width: 0;
}

.cell-title {
  font-size: 29rpx;
  color: var(--qt-text, #181818);
}

.cell-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--qt-text-3, #b2b2b2);
}

.cell-arrow {
  flex: none;
  margin-left: 16rpx;
  font-size: 34rpx;
  color: var(--qt-text-3, #c8c8c8);
}

.foot {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--qt-text-3, #b2b2b2);
}

/* ================= 浮窗/桌面指引面板 ================= */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 150;
  background-color: var(--qt-mask, rgba(0, 0, 0, 0.45));
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.22s ease, visibility 0.22s ease;
}

.mask.show {
  opacity: 1;
  visibility: visible;
}

.guide {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 12vh;
  z-index: 160;
  max-height: 72vh;
  display: flex;
  flex-direction: column;
  border-radius: 20rpx;
  background-color: var(--qt-card, #ffffff);
  box-shadow: var(--qt-shadow-strong, 0 8rpx 32rpx rgba(0, 0, 0, 0.12));
  opacity: 0;
  visibility: hidden;
  transform: scale(0.96);
  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
}

.guide.show {
  opacity: 1;
  visibility: visible;
  transform: scale(1);
}

.guide-hd {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx 18rpx;
  border-bottom: 1px solid var(--qt-border, #ededed);
}

.guide-title {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--qt-text, #181818);
}

.guide-close {
  font-size: 26rpx;
  color: var(--qt-primary, #07c160);
}

.guide-bd {
  height: 52vh;
  padding: 20rpx 28rpx 30rpx;
  box-sizing: border-box;
}

.guide-item {
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  background-color: var(--qt-bg, #f7f7f7);
}

.guide-item-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--qt-text, #181818);
}

.guide-item-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--qt-text-2, #7a7a7a);
}

.guide-note {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #ff9f0a;
}
