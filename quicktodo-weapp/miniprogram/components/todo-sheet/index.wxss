/* todo-sheet 样式：遮罩 + 底部面板（语音 / 快捷新增 / AI 预览导入） */

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 150;
  background-color: var(--qt-mask, rgba(0, 0, 0, 0.45));
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.22s ease, visibility 0.22s ease;
}

.mask.show {
  opacity: 1;
  visibility: visible;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 160;
  display: flex;
  flex-direction: column;
  max-height: 84vh;
  background-color: var(--qt-card, #ffffff);
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: var(--qt-shadow-strong, 0 8rpx 32rpx rgba(0, 0, 0, 0.12));
  transform: translateY(103%);
  transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  overflow: hidden;
}

.sheet.show {
  transform: translateY(0);
}

.hd {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx 18rpx;
  border-bottom: 1px solid var(--qt-border, #ededed);
}

.hd-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--qt-text, #181818);
}

.hd-close {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}

.hd-close .x1,
.hd-close .x2 {
  position: absolute;
  left: 10rpx;
  top: 23rpx;
  width: 28rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background-color: var(--qt-text-3, #b2b2b2);
}

.hd-close .x1 {
  transform: rotate(45deg);
}

.hd-close .x2 {
  transform: rotate(-45deg);
}

/* 内容区：定高 + 可收缩，保证 scroll-view 真的能滚 */
.bd {
  flex: 0 1 auto;
  height: 62vh;
  padding: 20rpx 30rpx 40rpx;
  box-sizing: border-box;
}

.tip {
  margin-top: 26rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--qt-text-3, #b2b2b2);
}

/* ================= 语音区 ================= */
.voice {
  padding: 22rpx 24rpx;
  border-radius: var(--qt-radius, 16rpx);
  background-color: var(--qt-primary-weak, rgba(7, 193, 96, 0.12));
  margin-bottom: 24rpx;
}

.voice.recording {
  background-color: rgba(7, 193, 96, 0.2);
}

.voice.error {
  background-color: var(--qt-danger-weak, rgba(250, 81, 81, 0.12));
}

.voice-hd {
  display: flex;
  align-items: center;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  background-color: var(--qt-primary, #07c160);
}

.dot.recording {
  animation: qt-blink 0.9s ease-in-out infinite;
}

.dot.error {
  background-color: #fa5151;
}

.dot.parsing {
  background-color: #ff9f0a;
}

@keyframes qt-blink {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.35;
    transform: scale(0.8);
  }
}

.voice-state {
  font-size: 26rpx;
  color: var(--qt-text, #181818);
}

.voice-text {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.7);
  font-size: 27rpx;
  color: var(--qt-text, #181818);
  word-break: break-all;
}

.voice-err {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #fa5151;
  line-height: 1.5;
}

.voice-tools {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.mini-btn {
  padding: 8rpx 22rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background-color: var(--qt-primary, #07c160);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1.7;
}

.mini-btn.ghost {
  background-color: rgba(255, 255, 255, 0.85);
  color: var(--qt-text, #181818);
  border: 1px solid var(--qt-border, #ededed);
}

.mini-btn.ghost.danger {
  color: #fa5151;
}

.manual {
  width: 100%;
  min-height: 96rpx;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background-color: var(--qt-card, #ffffff);
  font-size: 27rpx;
  color: var(--qt-text, #181818);
}

.ph {
  color: var(--qt-text-3, #b2b2b2);
  font-size: 26rpx;
}

/* ================= 表单区 ================= */
.block {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: var(--qt-radius, 16rpx);
  background-color: var(--qt-bg, #f7f7f7);
}

.block-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--qt-text-2, #7a7a7a);
}

.input {
  width: 100%;
  min-height: 90rpx;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background-color: var(--qt-card, #ffffff);
  font-size: 29rpx;
  color: var(--qt-text, #181818);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.row-label {
  font-size: 27rpx;
  color: var(--qt-text-2, #7a7a7a);
}

.picker {
  padding: 10rpx 22rpx;
  margin-left: 16rpx;
  border-radius: 12rpx;
  background-color: var(--qt-card, #ffffff);
  font-size: 27rpx;
  color: var(--qt-text, #181818);
}

/* 优先级分段控件 */
.seg {
  display: flex;
  align-items: center;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: var(--qt-card, #ffffff);
}

.seg-item {
  padding: 10rpx 30rpx;
  font-size: 26rpx;
  color: var(--qt-text-2, #7a7a7a);
}

.seg-item.on {
  color: #ffffff;
  background-color: #1989fa;
}

.seg-item.on.p-high {
  background-color: #fa5151;
}

.seg-item.on.p-normal {
  background-color: #1989fa;
}

.seg-item.on.p-low {
  background-color: #b2b2b2;
}

.submit {
  margin-top: 26rpx;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background-color: var(--qt-primary, #07c160);
  color: #ffffff;
  font-size: 30rpx;
  text-align: center;
}

.submit:active {
  background-color: var(--qt-primary-dark, #06ad56);
}

/* ================= AI 预览区 ================= */
.pv-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.engine {
  font-size: 22rpx;
  color: var(--qt-primary, #07c160);
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background-color: var(--qt-primary-weak, rgba(7, 193, 96, 0.12));
}

.pv-note {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #ff9f0a;
}

.pv-tools {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.pv-item {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background-color: var(--qt-card, #ffffff);
}

.pv-check {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  margin: 6rpx 16rpx 0 0;
  border: 2rpx solid var(--qt-border, #d9d9d9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.18s ease, border-color 0.18s ease;
}

.pv-check.on {
  background-color: var(--qt-primary, #07c160);
  border-color: var(--qt-primary, #07c160);
}

.pv-tick {
  width: 16rpx;
  height: 9rpx;
  border-left: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(-45deg);
  margin-top: -4rpx;
  opacity: 0;
}

.pv-check.on .pv-tick {
  opacity: 1;
}

.pv-main {
  flex: 1;
  min-width: 0;
}

.pv-input {
  width: 100%;
  font-size: 28rpx;
  color: var(--qt-text, #181818);
  padding: 4rpx 0;
}

.pv-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.pv-pick {
  padding: 6rpx 18rpx;
  margin-right: 14rpx;
  border-radius: 10rpx;
  background-color: var(--qt-bg, #f2f2f2);
  font-size: 23rpx;
  color: var(--qt-text-2, #7a7a7a);
}

.pv-pri {
  padding: 6rpx 20rpx;
  margin-right: 12rpx;
  border-radius: 10rpx;
  background-color: var(--qt-bg, #f2f2f2);
  font-size: 23rpx;
  color: var(--qt-text-2, #7a7a7a);
}

.pv-pri.on.p-high {
  background-color: #fa5151;
  color: #ffffff;
}

.pv-pri.on.p-normal {
  background-color: #1989fa;
  color: #ffffff;
}

.pv-pri.on.p-low {
  background-color: #b2b2b2;
  color: #ffffff;
}

.pv-del {
  margin-left: auto;
  padding: 6rpx 18rpx;
  font-size: 23rpx;
  color: #fa5151;
}

.import {
  margin-top: 26rpx;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background-color: var(--qt-primary, #07c160);
  color: #ffffff;
  font-size: 30rpx;
  text-align: center;
}

.import:active {
  background-color: var(--qt-primary-dark, #06ad56);
}
