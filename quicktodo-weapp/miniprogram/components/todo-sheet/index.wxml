<!--
  todo-sheet：底部弹出面板
  结构：遮罩 + 面板（语音区 / 快捷新增·编辑 / AI 预览导入）
-->
<view class="mask {{visible ? 'show' : ''}}" bindtap="onMaskTap"></view>

<view class="sheet {{visible ? 'show' : ''}}" catchtap="noop">
  <view class="hd">
    <text class="hd-title">{{mode === 'edit' ? '编辑待办' : '快速添加'}}</text>
    <view class="hd-close" bindtap="onClose">
      <view class="x1"></view>
      <view class="x2"></view>
    </view>
  </view>

  <scroll-view class="bd" scroll-y>
    <!-- ================= 1. 语音区 ================= -->
    <view class="voice {{voiceState}}">
      <view class="voice-hd">
        <view class="dot {{voiceState}}"></view>
        <text class="voice-state">{{stateText}}</text>
      </view>

      <view class="voice-text" wx:if="{{voiceText}}">{{voiceText}}</view>
      <view class="voice-err" wx:if="{{voiceError}}">{{voiceError}}</view>

      <view class="voice-tools">
        <view class="mini-btn" bindtap="onVoiceToggle">{{voiceState === 'recording' ? '结束录音' : '开始录音'}}</view>
        <view class="mini-btn ghost" bindtap="onManualParse">解析下面这段文字</view>
      </view>

      <textarea
        class="manual"
        placeholder="也可以直接输入：明天下午三点前把季度报表发给张总"
        placeholder-class="ph"
        maxlength="500"
        auto-height
        bindinput="onManualInput"
      ></textarea>
    </view>

    <!-- ================= 2. 快捷新增 / 编辑 ================= -->
    <view class="block">
      <view class="block-title">{{mode === 'edit' ? '修改内容' : '手动添加'}}</view>

      <textarea
        class="input"
        placeholder="要做什么？"
        placeholder-class="ph"
        maxlength="500"
        auto-height
        value="{{form.content}}"
        bindinput="onContentInput"
      ></textarea>

      <view class="row">
        <text class="row-label">截止时间</text>
        <switch checked="{{form.hasDeadline}}" color="#07C160" bindchange="onToggleDeadline" />
      </view>

      <view class="row" wx:if="{{form.hasDeadline}}">
        <picker mode="date" value="{{form.date}}" start="{{today}}" bindchange="onDateChange">
          <view class="picker">{{form.date ? form.date : '选择日期'}}</view>
        </picker>
        <picker mode="time" value="{{form.time}}" bindchange="onTimeChange">
          <view class="picker">{{form.time ? form.time : '选择时间'}}</view>
        </picker>
      </view>

      <view class="row">
        <text class="row-label">优先级</text>
        <view class="seg">
          <view
            class="seg-item {{form.priority === item.key ? 'on p-' + item.key : ''}}"
            wx:for="{{priorities}}"
            wx:key="key"
            data-p="{{item.key}}"
            bindtap="onPriority"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="submit" bindtap="onSubmit">{{mode === 'edit' ? '保存修改' : '添加到列表'}}</view>
    </view>

    <!-- ================= 3. AI 预览导入 ================= -->
    <view class="block" wx:if="{{preview.length > 0}}">
      <view class="pv-hd">
        <text class="block-title">AI 解析结果（{{preview.length}} 条）</text>
        <text class="engine">{{aiEngine === 'rule' ? '规则解析' : 'AI 解析'}}</text>
      </view>

      <view class="pv-note" wx:if="{{aiNote}}">{{aiNote}}</view>

      <view class="pv-tools">
        <view class="mini-btn ghost" bindtap="onToggleAll">{{allChecked ? '取消全选' : '全选'}}</view>
        <view class="mini-btn ghost danger" bindtap="onDiscardPreview">放弃这批</view>
      </view>

      <view class="pv-item" wx:for="{{preview}}" wx:key="key">
        <view class="pv-check {{item.checked ? 'on' : ''}}" data-index="{{index}}" bindtap="onToggleCheck">
          <view class="pv-tick"></view>
        </view>

        <view class="pv-main">
          <input
            class="pv-input"
            value="{{item.content}}"
            data-index="{{index}}"
            bindinput="onPreviewInput"
            maxlength="500"
            placeholder="待办内容"
            placeholder-class="ph"
          />

          <view class="pv-row">
            <picker mode="date" value="{{item.date}}" start="{{today}}" data-index="{{index}}" bindchange="onPreviewDate">
              <view class="pv-pick">{{item.date ? item.date : '无日期'}}</view>
            </picker>
            <picker mode="time" value="{{item.time}}" data-index="{{index}}" bindchange="onPreviewTime">
              <view class="pv-pick">{{item.time}}</view>
            </picker>
          </view>

          <view class="pv-row">
            <view
              class="pv-pri {{item.priority === p.key ? 'on p-' + p.key : ''}}"
              wx:for="{{priorities}}"
              wx:for-item="p"
              wx:key="key"
              data-index="{{index}}"
              data-p="{{p.key}}"
              bindtap="onPreviewPriority"
            >{{p.label}}</view>

            <view class="pv-del" data-index="{{index}}" bindtap="onPreviewDelete">删除</view>
          </view>
        </view>
      </view>

      <view class="import" bindtap="onImport">导入选中的 {{checkedCount}} 条</view>
    </view>

    <view class="tip">数据先写本机，联网后自动同步到 Mac 端</view>
  </scroll-view>
</view>
