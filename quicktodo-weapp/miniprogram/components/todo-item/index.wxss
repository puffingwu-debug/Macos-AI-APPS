/* todo-item 样式：克制阴影 + 12~20rpx 圆角，单位 rpx（1px 边框除外） */
.item {
  position: relative;
  display: flex;
  align-items: flex-start;
  padding: 24rpx 24rpx 24rpx 20rpx;
  margin-bottom: 16rpx;
  background-color: var(--qt-card, #ffffff);
  border-radius: var(--qt-radius, 16rpx);
  box-shadow: var(--qt-shadow, 0 2rpx 12rpx rgba(0, 0, 0, 0.04));
  overflow: hidden;
  transition: transform 0.12s ease, opacity 0.2s ease;
}

.item:active {
  transform: scale(0.99);
}

.item.is-done {
  opacity: 0.62;
}

/* 优先级色条：high 红 / normal 蓝 / low 灰 */
.prio-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  border-radius: 8rpx 0 0 8rpx;
}

.prio-bar.p-high {
  background-color: #fa5151;
}

.prio-bar.p-normal {
  background-color: #1989fa;
}

.prio-bar.p-low {
  background-color: #b2b2b2;
}

/* 复选框：勾选动画（缩放 + 底色过渡） */
.check {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin: 4rpx 20rpx 0 12rpx;
  border: 2rpx solid var(--qt-border, #d9d9d9);
  border-radius: 50%;
  background-color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
}

.check.checked {
  background-color: var(--qt-primary, #07c160);
  border-color: var(--qt-primary, #07c160);
  transform: scale(1.04);
}

.tick {
  width: 18rpx;
  height: 10rpx;
  border-left: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(-45deg) scale(0);
  opacity: 0;
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.18s ease;
  margin-top: -4rpx;
}

.check.checked .tick {
  transform: rotate(-45deg) scale(1);
  opacity: 1;
}

.body {
  flex: 1;
  min-width: 0;
}

.content {
  font-size: 30rpx;
  line-height: 1.45;
  color: var(--qt-text, #181818);
  word-break: break-all;
}

.item.is-done .content {
  color: var(--qt-text-2, #7a7a7a);
  text-decoration: line-through;
}

.meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  line-height: 1.6;
  padding: 0 10rpx;
  margin-right: 12rpx;
  margin-top: 6rpx;
  border-radius: 8rpx;
  background-color: rgba(0, 0, 0, 0.04);
  color: var(--qt-text-2, #7a7a7a);
}

/* 截止时间：今天高亮为主色，逾期为红色 */
.deadline.today {
  color: var(--qt-primary, #07c160);
  background-color: var(--qt-primary-weak, rgba(7, 193, 96, 0.12));
}

.deadline.overdue {
  color: #fa5151;
  background-color: var(--qt-danger-weak, rgba(250, 81, 81, 0.12));
}

/* 来源标签配色 */
.source.src-shot {
  color: #1989fa;
  background-color: rgba(25, 137, 250, 0.1);
}

.source.src-voice {
  color: #07c160;
  background-color: rgba(7, 193, 96, 0.1);
}

.source.src-manual {
  color: var(--qt-text-2, #7a7a7a);
}

.arrow {
  flex: none;
  margin-left: 8rpx;
  color: var(--qt-text-3, #c8c8c8);
  font-size: 32rpx;
  line-height: 1;
  align-self: center;
}
